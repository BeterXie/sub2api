FROM sub2api:v2.9.8-prism-frontend-tests AS frontend-builder
WORKDIR /app/frontend
COPY frontend/ ./
RUN ["node", "node_modules/vitest/vitest.mjs", "run", "src/i18n/__tests__/localeKeyCompleteness.spec.ts", "src/features/channel-monitor-v3/__tests__", "src/views/admin/__tests__/SettingsView.spec.ts", "src/views/admin/__tests__/AutoConfigView.spec.ts", "src/views/admin/__tests__/AccountQualityView.spec.ts", "src/views/admin/__tests__/ChannelMonitorView.modeSwitch.spec.ts", "src/views/user/__tests__/ChannelStatusView.mode.spec.ts", "src/components/admin/account/__tests__/IQTestModal.spec.ts", "src/components/account/__tests__/EditAccountModal.grokForbiddenPause.spec.ts", "src/utils/__tests__/qualityRulePatch.spec.ts"]
RUN ["node", "node_modules/vue-tsc/bin/vue-tsc.js", "--noEmit"]
RUN ["node", "node_modules/vite/bin/vite.js", "build"]

FROM sub2api:v2.9.8-prism-usage-verify AS backend-builder
ENV CGO_ENABLED=0 GOMAXPROCS=2
WORKDIR /app/backend
COPY backend/ ./
COPY --from=frontend-builder /app/backend/internal/web/dist ./internal/web/dist
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-gobuild,target=/root/.cache/go-build \
    ["go", "test", "-json", "-p", "2", "-tags=unit", "./internal/service", "./internal/handler", "./internal/repository", "./internal/config", "./internal/server", "./internal/server/routes", "./internal/pkg/upstreamroute", "-run", "Prism|Compact.*Keepalive|SSEKeepalive|Passthrough.*Keepalive|OpenAIForwardMayFailover|OpenAIForwardErrorAlreadyCommunicated|ChannelMonitorV3|Quality|GrokForbidden|Prism|Contract|Migration|Regional|UpstreamRoute|TurnAdmission|OAuthAutoConfig", "-count=1", "-timeout=8m"]
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-gobuild,target=/root/.cache/go-build \
    ["go", "test", "-p", "2", "-tags=unit", "./internal/config", "./internal/server", "./internal/server/routes", "./internal/pkg/upstreamroute", "./internal/pkg/qualityqueue", "-count=1", "-timeout=5m"]
RUN ["apk", "add", "--no-cache", "gcc", "musl-dev"]
ENV CGO_ENABLED=1
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-gobuild,target=/root/.cache/go-build \
    ["go", "test", "-p", "2", "-race", "-tags=unit", "./internal/service", "-run", "TestPrism.*Keepalive|TestPrismEventHeartbeat|TestOpenAISSEKeepalive_ReentryKeepsEarlierCommentBytes", "-count=1", "-timeout=5m"]
ENV CGO_ENABLED=0
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-gobuild,target=/root/.cache/go-build \
    ["go", "build", "-p", "2", "-tags=embed", "-ldflags=-s -w -X main.Version=2.9.10 -X main.Commit=prism-relay-20261006 -X main.Date=2026-10-06 -X main.BuildType=release", "-trimpath", "-o", "/app/sub2api", "./cmd/server"]

FROM sub2api:2.9.8-prism-relay-20261005
COPY --from=backend-builder --chmod=755 --chown=sub2api:sub2api /app/sub2api /app/sub2api
