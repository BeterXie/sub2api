FROM golang:1.27.0-alpine

ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=sum.golang.google.cn
RUN ["apk", "add", "--no-cache", "git", "ca-certificates"]
WORKDIR /app/backend
COPY backend/ ./
RUN --mount=type=cache,id=sub2api-gomod,target=/go/pkg/mod \
    --mount=type=cache,id=sub2api-gobuild,target=/root/.cache/go-build \
    ["go", "test", "-tags=unit", "./internal/service", "./internal/repository", "./internal/handler/admin", "./internal/handler/dto", "./pkg/pluginapi/v1", "-run", "Plugin|Update|Prism|StateProbe|ProbeOpenAICodexState|RecordUsage|UsageLog|PrepareUsageLogInsert", "-count=1", "-timeout=5m"]
